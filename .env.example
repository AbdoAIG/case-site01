# ==========================================
# 1. الربط مع Google Sheets + Google Drive كقاعدة بيانات سحابية مجانية (موصى به)
# ==========================================
# ضع رابط Web App الذي نسخته من Google Apps Script هنا ليعمل جوجل شيت كقاعدة بيانات مباشرة:
GOOGLE_SCRIPT_URL=""
GOOGLE_SCRIPT_SECRET=""

# ==========================================
# 2. إعدادات قاعدة البيانات المحلية (SQLite للتطوير أو Postgres للإنتاج)
# ==========================================
DATABASE_URL="file:./dev.db"

# ==========================================
# 3. إعدادات المصادقة والأمان
# ==========================================
ADMIN_USERNAME="admin"

# هاش كلمة مرور المدير (يدعم scrypt:salt:hash بدون تعارض مع رموز $)
# القيمة الافتراضية أدناه تقابل كلمة المرور التجريبية: ChangeMeStrong!2026
ADMIN_PASSWORD_HASH="scrypt:a1b2c3d4e5f60718293a4b5c6d7e8f90:4dc7bb8b9cc4777f7a0d602cd61010bcba21fcda7ed5821fb4a398b6605d30e8eaa2cce101ea0689bd9d25d9490b37e62c454b847cdff0aeac97b6f18e253e28"

# مفتاح سري لتوقيع جلسات الكوكيز ورموز CSRF
SESSION_SECRET="replace-with-a-64-char-random-hex-secret-key-for-hmac-signing-2026"

# ==========================================
# 4. إعدادات التخزين والرفع
# ==========================================
MAX_UPLOAD_MB="25"
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"

# ==========================================
# 5. المحتوى الافتراضي للقضية
# ==========================================
DEFAULT_CASE_TITLE="توضيح تفاصيل القضية والمرفقات المصورة"
DEFAULT_CASE_DESCRIPTION="تحتوي هذه الصفحة على شرح كامل لتفاصيل القضية مع جميع الصور ومقاطع الفيديو التوضيحية المرتبطة بها."
